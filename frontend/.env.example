# Copy this file to ".env" (same folder as package.json) and restart `npm run dev`.

# Base URL of your teammate's backend (no trailing slash).
# The frontend will call: POST ${VITE_API_BASE_URL}/analyze
VITE_API_BASE_URL=http://localhost:8000

# "true"  -> start in DEMO mode (uses built-in demo data, no backend needed)
# "false" -> start in LIVE mode (calls the real backend)
# You can also flip this at runtime with the toggle in the header.
VITE_DEMO_MODE=true
